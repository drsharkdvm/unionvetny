# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored — never commit real secrets.

# --- Google Analytics 4 ---
# Optional — the app falls back to the committed ID in src/lib/site.ts if unset.
NEXT_PUBLIC_GA_ID=G-QJTGCWL7D4

# --- Contact form email (Resend) ---
# Server-only secret (NO "NEXT_PUBLIC_" prefix) — used by src/app/actions/contact.ts.
# Get it from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Where contact-form submissions are delivered (defaults to info@unionvetny.com).
CONTACT_TO_EMAIL=info@unionvetny.com

# The "From" address. It MUST be on a domain you've verified in Resend.
# Until unionvetny.com is verified, Resend's test sender only delivers to the
# account owner's email: "Union Vet Website <onboarding@resend.dev>".
CONTACT_FROM_EMAIL=Union Vet <website@unionvetny.com>
